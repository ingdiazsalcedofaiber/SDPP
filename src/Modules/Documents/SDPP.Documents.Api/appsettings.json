{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }, { "Name": "Seq", "Args": { "serverUrl": "http://seq:80" } }]
  },
  "ConnectionStrings": {
    "DocumentsDb": "Server=sql-server,1433;Database=SDPP_Documents;User Id=sdpp_app;Password=__set-via-secret__;TrustServerCertificate=True"
  },
  "Authentication": {
    "Issuer": "sdpp-identity",
    "Audience": "sdpp-platform",
    "SigningKey": "__set-via-secret__"
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Services": {
    "ClassificationApi": "http://sdpp-classification-api",
    "InternalApiKey": "__set-via-secret__"
  },
  "Documents": {
    "DefaultStorageQuotaBytes": 5368709120
  },
  "ObjectStorage": {
    "Endpoint": "minio:9000",
    "AccessKey": "__set-via-secret__",
    "SecretKey": "__set-via-secret__",
    "UseSsl": false
  },
  "ClamAv": {
    "Host": "clamav",
    "Port": 3310
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "VirtualHost": "/",
    "Username": "__set-via-secret__",
    "Password": "__set-via-secret__"
  },
  "AllowedHosts": "*"
}
