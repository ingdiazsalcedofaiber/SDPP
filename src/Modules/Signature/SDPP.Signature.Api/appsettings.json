{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }]
  },
  "ConnectionStrings": {
    "SignatureDb": "Server=sql-server,1433;Database=SDPP_Signature;User Id=sa;Password=__set-via-secret__;TrustServerCertificate=True"
  },
  "Authentication": {
    "Issuer": "sdpp-identity",
    "Audience": "sdpp-platform",
    "SigningKey": "__set-via-secret__"
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Services": {
    "DocumentsApi": "http://sdpp-documents-api",
    "IdentityApi": "http://sdpp-identity-api",
    "AuditApi": "http://sdpp-audit-api",
    "InternalApiKey": "__set-via-secret__"
  },
  "Signature": {
    "KeyEncryptionKey": "__set-via-secret__",
    "LegalApprovalStampEmail": "gerencia.legal@clinaltec.com.co"
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "VirtualHost": "/",
    "Username": "__set-via-secret__",
    "Password": "__set-via-secret__"
  },
  "AllowedHosts": "*"
}
