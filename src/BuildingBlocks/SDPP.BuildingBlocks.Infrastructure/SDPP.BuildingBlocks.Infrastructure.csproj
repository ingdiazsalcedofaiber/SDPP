    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDPP.BuildingBlocks.Domain\SDPP.BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\SDPP.BuildingBlocks.Application\SDPP.BuildingBlocks.Application.csproj" />
  </ItemGroup>

</Project>
