# Copy to .env.local for local development (never commit .env.local).
# Points at the Gateway inside the corporate intranet — see docs/01-architecture/c4-diagrams.md.
VITE_API_BASE_URL=http://localhost:5080

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# MUST be the exact same value as Identity__GoogleClientId in deploy/compose/docker-compose.yml —
# the frontend uses it to initialize Google Identity Services, the backend uses it to validate the
# ID token's audience. See docs on autenticación con Google for the full setup steps.
VITE_GOOGLE_CLIENT_ID=__PENDIENTE__.apps.googleusercontent.com
