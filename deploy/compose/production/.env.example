# Copy this file to ".env" in the same directory and fill in real values. Never commit the real
# ".env" — deploy/compose/production/.gitignore (and the repo root .gitignore's ".env*" rule)
# already excludes it, this file is the only one meant to be tracked.
#
# Generate random secrets with, e.g.:  openssl rand -base64 32

# --- SQL Server ---
SDPP_SA_PASSWORD=
SDPP_APP_DB_PASSWORD=

# --- RabbitMQ ---
SDPP_RABBITMQ_USER=
SDPP_RABBITMQ_PASSWORD=

# --- MinIO / object storage ---
SDPP_MINIO_USER=
SDPP_MINIO_PASSWORD=
SDPP_MINIO_KMS_KEY=

# --- Seq (centralized logging) — see https://docs.datalust.co/docs/security#initial-admin-account
# for how to generate SDPP_SEQ_ADMIN_PASSWORD_HASH ---
SDPP_SEQ_ADMIN_PASSWORD_HASH=

# --- Shared platform secrets ---
SDPP_JWT_SIGNING_KEY=
SDPP_INTERNAL_API_KEY=
SDPP_MFA_ENCRYPTION_KEY=
SDPP_SIGNATURE_KEY_ENCRYPTION_KEY=
SDPP_PROTECTION_HMAC_KEY=

# --- Google OAuth (Google Cloud Console → OAuth Client ID) ---
SDPP_GOOGLE_CLIENT_ID=
SDPP_BOOTSTRAP_ADMIN_EMAIL=

# --- Public URL (behind Apache, see deploy/apache/sdpp.conf) ---
SDPP_PUBLIC_WEB_URL=https://sdpp.intranet

# --- SMTP (institutional mail server) — leave SDPP_SMTP_HOST empty to keep using
# LoggingEmailSender (no real email sent, only logged) until this is filled in ---
SDPP_SMTP_HOST=
SDPP_SMTP_PORT=587
SDPP_SMTP_USER=
SDPP_SMTP_PASSWORD=
SDPP_SMTP_FROM=sdpp@yourcompany.com
SDPP_SMTP_USE_SSL=false
